<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>WispTorchHeeler</AssemblyName>
    <RootNamespace>WispTorchHeeler</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.3.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageWebsiteUrl>https://github.com/dreamwraith/Valheim-WispTorchHeeler</PackageWebsiteUrl>
    <PackageDescription>Tiered Mistlands wisp torches and lamps with expanded mist clearance, interactive torch painting, body-worn Wisplight customization, and multiplayer color synchronization.</PackageDescription>
    <Authors>dreamwraith</Authors>
    <Company>https://github.com/dreamwraith</Company>
    <Description>Tiered Mistlands wisp torches and lamps with expanded mist clearance, interactive torch painting, body-worn Wisplight customization, and multiplayer color synchronization.</Description>
    <PackageProjectUrl>https://github.com/dreamwraith/Valheim-WispTorchHeeler</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dreamwraith/Valheim-WispTorchHeeler</RepositoryUrl>
    <!-- Nexus Mods Identifiers -->
    <NexusModId>4331</NexusModId>
    <NexusFileId></NexusFileId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mod Framework Dependencies (ConditionalConfigSync) -->
    <Reference Include="ConditionalConfigSync">
      <HintPath Condition="Exists('$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll')">$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll</HintPath>
      <HintPath Condition="!Exists('$(BEPINEX_PATH)\plugins\shudnal-ConditionalConfigSync\ConditionalConfigSync.dll') and Exists('$(BEPINEX_PATH)\plugins\ConditionalConfigSync.dll')">$(BEPINEX_PATH)\plugins\ConditionalConfigSync.dll</HintPath>
      <HintPath Condition="Exists('Libs\ConditionalConfigSync.dll')">Libs\ConditionalConfigSync.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Generate VersionInfo.g.cs from $(Version) so Plugin.ModVersion is always in sync -->
  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <VersionInfoFile>$(IntermediateOutputPath)VersionInfo.g.cs</VersionInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <VersionInfoLines Include="// &lt;auto-generated /&gt;" />
      <VersionInfoLines Include="namespace WispTorchHeeler" />
      <VersionInfoLines Include="{" />
      <VersionInfoLines Include="    internal static class VersionInfo" />
      <VersionInfoLines Include="    {" />
      <VersionInfoLines Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <VersionInfoLines Include="    }" />
      <VersionInfoLines Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(VersionInfoFile)" Lines="@(VersionInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionInfoFile)" />
      <FileWrites Include="$(VersionInfoFile)" />
    </ItemGroup>
  </Target>
  <!-- Keep manifest.json automatically synchronized with $(Version) and package properties -->
  <Target Name="GenerateManifest" BeforeTargets="BeforeBuild;PackageMod">
    <ItemGroup>
      <ManifestLines Include="{" />
      <ManifestLines Include="%20%20&quot;name&quot;: &quot;$(AssemblyName)&quot;," />
      <ManifestLines Include="%20%20&quot;version_number&quot;: &quot;$(Version)&quot;," />
      <ManifestLines Include="%20%20&quot;website_url&quot;: &quot;$(PackageWebsiteUrl)&quot;," />
      <ManifestLines Include="%20%20&quot;description&quot;: &quot;$(PackageDescription)&quot;," />
      <ManifestLines Include="%20%20&quot;dependencies&quot;: [" />
      <ManifestLines Include="%20%20%20%20&quot;denikson-BepInExPack_Valheim-5.4.2350&quot;," />
      <ManifestLines Include="%20%20%20%20&quot;ValheimModding-Jotunn-2.30.2&quot;," />
      <ManifestLines Include="%20%20%20%20&quot;shudnal-ConditionalConfigSync-1.0.9&quot;" />
      <ManifestLines Include="%20%20]" />
      <ManifestLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(ProjectDir)manifest.json" Lines="@(ManifestLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- Create Thunderstore / Nexus Mods distribution package on Release build -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipPackageMod)' != 'true'" DependsOnTargets="GenerateManifest">
    <PropertyGroup>
      <PackageStagingDir>$(ProjectDir)bin\PackageTemp</PackageStagingDir>
      <PackagePublishDir>$(ProjectDir)bin\Publish</PackagePublishDir>
      <PackageZipFile>$(PackagePublishDir)\$(AssemblyName)-$(Version).zip</PackageZipFile>
    </PropertyGroup>
    <MakeDir Directories="$(PackageStagingDir);$(PackagePublishDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStagingDir)" />
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)manifest.json')" />
    <Copy SourceFiles="$(ProjectDir)icon.png" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)icon.png')" />
    <Copy SourceFiles="$(ProjectDir)README.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)README.md')" />
    <Copy SourceFiles="$(ProjectDir)CHANGELOG.md" DestinationFolder="$(PackageStagingDir)" Condition="Exists('$(ProjectDir)CHANGELOG.md')" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageZipFile)" Overwrite="true" />
    <RemoveDir Directories="$(PackageStagingDir)" />
    <Message Importance="High" Text="[PackageMod] Successfully generated mod release package: $(PackageZipFile)" />
  </Target>
</Project>